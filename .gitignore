# What this scaffold builds, not what an editor or OS drops beside it —
# those live in ~/.config/git/gitignore_global, not here.

/forge-dashboard
/dist
coverage.out
junit.xml

node_modules/
.bun-cache/

# Playwright's own run output, not something to commit.
/test-results/
/playwright-report/

# The admin session globalSetup registers once and every admin test
# reuses — a real session cookie, generated fresh each run.
/tests/.auth/

# The auth database a local or CI run writes to — never committed, and the
# default path (/data/forge-dashboard.db) is outside the repo anyway; this
# only catches a run that pointed DB_PATH inside it.
/data/
/tmp-e2e-data/

# Written by the release job, not by hand.
CHANGELOG.md

# Vale's style packages, downloaded by `vale sync`.
/styles/Google/
/styles/proselint/

# SvelteKit build tooling's own generated output — never hand-edited, and
# rebuilt fresh (`bun run build:web`) before every `go build`, so nothing
# here is worth committing. See web/vite.config.ts's own comment for why
# the build lands in web/build rather than internal/api/static directly.
/web/.svelte-kit/
/web/build/

# The merged output of a migrated Svelte page — scripts/sync-web-build.sh
# writes these paths into internal/api/static, which //go:embed reads at
# compile time; not committed, same as any other build output. A page not
# yet migrated has no entry here and stays a tracked, hand-written file.
/internal/api/static/webhooks.html
/internal/api/static/settings.html
/internal/api/static/privacy.html
/internal/api/static/disclaimer.html
/internal/api/static/releases.html
/internal/api/static/login.html
/internal/api/static/_app/
