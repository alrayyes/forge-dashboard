{
  "name": "forge-dashboard-tooling",
  "private": true,
  "description": "The Go backend is the real application; this covers its frontend -- a SvelteKit app (see web/) being migrated to incrementally, alongside the vanilla-JS/CSS pages it hasn't replaced yet -- and the surrounding tooling: commitlint's shared config, Prettier, markdownlint, Redocly, the Playwright accessibility journey tests, and the Lighthouse CI audit, both run against the built binary.",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build:web": "bun run --filter web build && ./scripts/sync-web-build.sh",
    "capture-screenshots": "tsx scripts/capture-screenshots.ts",
    "check:tests": "tsc -p tsconfig.json",
    "check:web": "bun run --filter web check",
    "format:check": "prettier --check \"**/*.{md,yml,yaml,svelte}\"",
    "lint:api": "redocly lint",
    "lint:api:security": "spectral lint api/openapi.yaml",
    "lint:js": "biome check",
    "lint:links": "bun scripts/check-doc-links.ts",
    "lint:md": "markdownlint-cli2",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "lint:pkg": "sort-package-json --check package.json web/package.json",
    "lint:prose": "./scripts/lint-prose.sh",
    "lint:refs": "bun scripts/check-doc-ticket-refs.ts",
    "lint:specs": "bun scripts/check-spec-api-routes.ts",
    "prepare": "lefthook install",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "test:unit": "bun test web/src scripts"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "overrides": {
    "@puppeteer/browsers": "3.2.5",
    "basic-ftp": "6.2.3",
    "katex": "0.19.0",
    "smol-toml": "1.9.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.70.0",
    "@stoplight/spectral-cli": "6.17.0",
    "@stoplight/spectral-owasp-ruleset": "2.0.1",
    "@types/node": "26.6.5",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "sort-package-json": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wait-on": "9.5.1"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "lefthook"
  ]
}
