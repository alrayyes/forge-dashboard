{
  "name": "forge-dashboard-tooling",
  "private": true,
  "description": "The Go backend is the real application; this covers its static vanilla-JS/CSS frontend (linted and formatted by Biome) and the surrounding tooling -- commitlint's shared config, Prettier, markdownlint, Redocly, and the Playwright accessibility journey tests run against the built binary.",
  "packageManager": "bun@1.3.14",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.52.0",
    "lefthook": "2.1.12",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "wait-on": "9.1.0"
  },
  "trustedDependencies": [
    "lefthook"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "lint:md": "markdownlint-cli2",
    "lint:js": "biome check",
    "lint:api": "redocly lint",
    "lint:prose": "./scripts/lint-prose.sh",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "test:e2e": "playwright test"
  }
}
