{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/login.html",
        "http://localhost:8080/",
        "http://localhost:8080/issues.html",
        "http://localhost:8080/insights.html",
        "http://localhost:8080/settings.html",
        "http://localhost:8080/changelog.html"
      ],
      "numberOfRuns": 3,
      "puppeteerScript": "./scripts/lighthouse-session.js",
      "puppeteerLaunchOptions": {
        "args": ["--no-sandbox"]
      },
      "settings": {
        "onlyCategories": ["performance", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "redirects": "warn",
        "cache-insight": "warn",
        "document-latency-insight": "warn",
        "render-blocking-insight": "warn",
        "network-dependency-tree-insight": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
