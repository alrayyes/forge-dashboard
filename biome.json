{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/*.html",
      "!**/*.svg",
      "!**/*.svelte",
      "!**/*.md",
      "!.claude/worktrees",
      "!tests/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "warn"
      },
      "correctness": {
        "noInvalidGridAreas": "off"
      },
      "suspicious": {
        "useBaseline": "warn"
      }
    },
    "domains": {
      "types": "all"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
